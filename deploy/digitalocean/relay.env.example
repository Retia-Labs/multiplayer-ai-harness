NODE_ENV=production
HUB_HOST=127.0.0.1
PORT=7777
HUB_DB=/var/lib/plexus/plexus.sqlite
PLEXUS_AUTH_MODE=github
PLEXUS_PUBLIC_ORIGIN=https://app.tryplexus.dev
PLEXUS_ALPHA_GITHUB_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: immutable, operator-owned installer directory containing release.json and its DMG.
# Enabling this exposes the checked installer only to authenticated invited accounts.
# PLEXUS_DESKTOP_RELEASE_DIR=/opt/plexus/downloads/0.2.0-alpha.1
