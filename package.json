{
  "name": "multiplayer-ai-harness",
  "version": "0.1.0",
  "description": "Multiplayer, bring-your-own-provider AI coding harness: hub + runtimes + shared web/desktop UI (prototype). Includes the original Codex desktop clone.",
  "main": "apps/desktop/main.js",
  "scripts": {
    "start": "electron .",
    "hub": "node packages/hub/server.js",
    "runtime": "node packages/runtime/index.js",
    "desktop": "electron apps/desktop/main.js",
    "codex-clone": "electron src/main/main.js",
    "test": "npm run test:protocol && npm run test:unit && npm run test:team && npm run test:e2e",
    "test:protocol": "node test/protocol-smoke.js",
    "test:unit": "node test/unit.js",
    "test:e2e": "node test/e2e-multiplayer.js",
    "smoke": "node test/smoke.js",
    "test:desktop": "xvfb-run -a node test/desktop-smoke.js",
    "test:team": "node test/team-boundaries.js",
    "check:design": "node scripts/check-design-contract.js",
    "test:design": "node --test test/design-contract.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "playwright-core": "^1.49.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
