{
  "name": "multiplayer-ai-harness",
  "version": "0.1.0",
  "description": "Multiplayer, bring-your-own-provider AI coding harness: hub + execution hosts + shared web/desktop UI.",
  "main": "apps/desktop/main.js",
  "scripts": {
    "start": "electron .",
    "hub": "node packages/hub/server.js",
    "runtime": "node packages/runtime/index.js",
    "desktop": "electron apps/desktop/main.js",
    "codex-clone": "electron src/main/main.js",
    "test": "npm run test:protocol && npm run test:unit && npm run test:team && npm run test:codex && npm run test:e2e && npm run test:encrypted-task && npm run test:teammate-enrollment && npm run test:import-forgery && npm run test:key-exchange && npm run test:steering && npm run test:approvals && npm run test:encrypted-real-task && npm run test:catchup && npm run test:catchup:view && npm run test:catchup:encrypted && npm run test:collaboration-integration",
    "test:protocol": "node test/protocol-smoke.js",
    "test:unit": "node test/unit.js",
    "test:e2e": "node test/e2e-multiplayer.js",
    "smoke": "node test/smoke.js",
    "test:e2ee": "npm run test:e2ee:acceptance && node test/e2ee-complete.js",
    "test:e2ee:spike": "node test/e2ee-spike.js",
    "test:desktop": "node test/desktop-smoke.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "test:codex": "npm run test:codex:app-server && npm run test:codex:exec && node test/codex-acceptance.js --lane control --out .artifacts/codex-control",
    "test:codex:exec": "node --test test/codex-exec-contract.js",
    "test:codex:app-server": "node --test test/codex-app-server.js test/codex-host-profile.js test/codex-account-configuration.js",
    "test:codex:inventory": "node --test test/codex-no-environment-inventory.js test/codex-host-tools-preflight.js",
    "proof:codex": "node test/codex-acceptance.js",
    "codex:probe": "node -e \"console.log(JSON.stringify(require('./packages/runtime/codex-probe').probe(), null, 2))\"",
    "test:team": "node test/team-boundaries.js",
    "check:design": "node scripts/check-design-contract.js",
    "test:design": "node --test test/design-contract.js",
    "test:desktop-bootstrap": "node test/desktop-bootstrap.js",
    "test:desktop:install": "node scripts/desktop-install-proof.js",
    "test:e2ee:acceptance": "node test/e2ee-acceptance.js",
    "test:e2ee:identity": "node --test test/endpoint-cross-signing.js",
    "test:e2ee:platform": "node scripts/e2ee-platform-proof.js",
    "test:encrypted-task:node": "node test/encrypted-task.js",
    "test:encrypted-task:browser": "node test/encrypted-task-browser.js",
    "test:encrypted-task": "npm run test:encrypted-task:node && npm run test:encrypted-task:browser",
    "test:teammate-enrollment:node": "node test/teammate-enrollment.js",
    "test:teammate-enrollment:browser": "node test/teammate-enrollment-browser.js",
    "test:teammate-enrollment": "npm run test:teammate-enrollment:node && npm run test:teammate-enrollment:browser",
    "test:import-forgery": "node test/e2ee-import-forgery.js",
    "test:key-exchange": "node test/hub-key-exchange.js",
    "test:steering": "node test/shared-steering.js",
    "test:approvals": "node test/approval-grants.js",
    "test:help-inbox": "node test/help-inbox.js",
    "test:handover": "node test/handover.js",
    "test:related-work": "node test/related-work.js",
    "test:recovery": "node test/recovery.js",
    "test:recover-after-loss": "node test/recover-after-loss.js",
    "test:revocation": "node test/revocation.js",
    "test:encrypted-real-task": "node test/encrypted-real-task.js",
    "test:encrypted-codex-task": "node test/encrypted-codex-task.js",
    "test:codex-confinement": "node test/codex-confinement.js",
    "test:confined-writes": "node test/confined-writes.js",
    "test:catchup": "node test/catchup.js",
    "test:catchup:view": "node test/catchup-view.js",
    "test:catchup:encrypted": "node test/catchup-encrypted-browser.js",
    "test:encrypted-controls": "node --test test/encrypted-runtime-e2e.js test/task-control-receipts.js test/encrypted-run-events.js test/approval-authority-removal.js test/task-history-retry.js",
    "test:enrollment-authority": "node --test test/enrollment-authority.js test/freshness-protocol.js test/authority-revocation.js test/genesis-revocation-protocol.js test/implicit-authority-state.js test/genesis-host-revocation.js",
    "test:local-authority": "node --test test/local-runtime-rpc.js test/local-runtime-control.js",
    "test:desktop:authority-recovery": "node test/desktop-authority-recovery.js",
    "test:desktop:genesis-revocation": "node test/desktop-genesis-revocation.js",
    "test:genesis-removal-ui": "node test/genesis-removal-ui-browser.js",
    "test:recovery-trust": "node --test test/recovery-trust.js",
    "test:durable-host": "node --test test/durable-host.js",
    "test:runtime-lifecycle": "node --test test/encrypted-runtime-lifecycle.js",
    "test:desktop-isolation": "node --test test/desktop-profile-isolation.js",
    "test:client-storage": "node test/encrypted-client-storage-browser.js",
    "test:mailbox": "node test/encrypted-mailbox-browser.js",
    "proof:codex:interactive": "node test/codex-interactive-real.js",
    "test:encrypted-workspace": "node test/encrypted-workspace-browser.js",
    "test:collaboration-integration": "npm run test:e2ee:identity && npm run test:enrollment-authority && npm run test:local-authority && npm run test:encrypted-controls && npm run test:runtime-lifecycle && npm run test:recovery-trust && npm run test:help-inbox && npm run test:handover && npm run test:related-work && npm run test:recovery && npm run test:recover-after-loss && npm run test:revocation && npm run test:confined-writes && npm run test:client-storage && npm run test:mailbox && npm run test:encrypted-workspace && npm run test:genesis-removal-ui"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.49.0"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.8.0",
    "ws": "^8.21.3"
  },
  "productName": "Plexus",
  "build": {
    "appId": "dev.tryplexus.desktop",
    "productName": "Plexus",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "files": [
      "apps/desktop/**/*",
      "apps/web/**/*",
      "packages/**/*",
      "package.json",
      "!**/*.map",
      "!test/**",
      "!docs/**",
      "!src/**"
    ],
    "extraMetadata": {
      "main": "apps/desktop/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    }
  }
}
